<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bam.Maui.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BamFrameworkRoot)bam.base\bam.base\bam.base.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.console\bam.console\bam.console.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.test\bam.test\bam.test.csproj" />
    <ProjectReference Include="..\bam.maui\bam.maui.csproj" />
  </ItemGroup>

  <!-- The sample app's platform-free parts, compiled in so its settings and text are tested without a device. -->
  <ItemGroup>
    <Compile Include="..\bam.maui.sample\SampleSettings.cs" Link="Sample\SampleSettings.cs" />
    <Compile Include="..\bam.maui.sample\SampleNavigator.cs" Link="Sample\SampleNavigator.cs" />
    <Compile Include="..\bam.maui.sample\SignedInPage.cs" Link="Sample\SignedInPage.cs" />
    <EmbeddedResource Include="..\bam.maui.sample\samplesettings.json" LogicalName="samplesettings.json" Link="Sample\samplesettings.json" />
  </ItemGroup>

</Project>
