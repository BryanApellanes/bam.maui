<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The plain net10.0 target carries the passkey contracts and orchestration so they build and test without a device. -->
		<TargetFrameworks>net10.0</TargetFrameworks>
		<!-- bamtk.sln is built into one output folder (run-tests.sh), where several targets of one project would overwrite
		     each other, so inside that solution only net10.0 is built.  bamtest sets BamPlatformTargets=false for the test
		     projects it builds, which turns the platform targets off the same way.  Building this project directly or from an
		     app solution builds every target.  -p:BamMauiPlatformTargets=true|false overrides all of these. -->
		<BamMauiPlatformTargets Condition="'$(BamMauiPlatformTargets)' == '' And '$(BamPlatformTargets)' == 'false'">false</BamMauiPlatformTargets>
		<BamMauiPlatformTargets Condition="'$(BamMauiPlatformTargets)' == '' And '$(SolutionFileName)' == 'bamtk.sln'">false</BamMauiPlatformTargets>
		<BamMauiPlatformTargets Condition="'$(BamMauiPlatformTargets)' == ''">true</BamMauiPlatformTargets>
		<!-- The Apple and Android workloads do not restore on Linux, so platform targets are added everywhere else. -->
		<TargetFrameworks Condition="'$(BamMauiPlatformTargets)' == 'true' And !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(BamMauiPlatformTargets)' == 'true' And $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- UseMaui needs the MAUI workload even for net10.0, so a net10.0-only build goes without it: a machine with just the
		     .NET SDK can then restore and build bamtk.sln.  The Microsoft.Maui.Controls package is all net10.0 needs. -->
		<UseMaui Condition="'$(BamMauiPlatformTargets)' == 'true'">true</UseMaui>
		<SingleProject Condition="'$(BamMauiPlatformTargets)' == 'true'">true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Bam.Maui</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- The usings UseMaui would add, for a build without it. -->
	<ItemGroup Condition="'$(UseMaui)' != 'true'">
		<Using Include="Microsoft.Maui" />
		<Using Include="Microsoft.Maui.Controls" />
		<Using Include="Microsoft.Maui.Graphics" />
		<Using Include="Microsoft.Maui.ApplicationModel" />
		<Using Include="Microsoft.Maui.Devices" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
		<!-- Android Credential Manager.  Microsoft's binding of androidx.credentials; bamtk has no equivalent. -->
		<PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.5.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<PropertyGroup>
		<BamTargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</BamTargetPlatform>
	</PropertyGroup>

	<!-- Each platform's authenticator compiles only where its API exists.  The Windows one is plain P/Invoke, so it also
	     compiles for net10.0, where its tests run. -->
	<ItemGroup>
		<Compile Remove="Passkeys/Native/Android/**" Condition="'$(BamTargetPlatform)' != 'android'" />
		<Compile Remove="Passkeys/Native/Apple/**" Condition="'$(BamTargetPlatform)' != 'ios' And '$(BamTargetPlatform)' != 'maccatalyst'" />
		<Compile Remove="Passkeys/Native/Windows/**" Condition="'$(BamTargetPlatform)' != 'windows' And '$(BamTargetPlatform)' != ''" />
		<InternalsVisibleTo Include="bam.maui.tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(BamFrameworkRoot)bam.base\bam.base\bam.base.csproj" />
	</ItemGroup>

</Project>
